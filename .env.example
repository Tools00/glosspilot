# GlossPilot environment variables
# Copy to .env and fill in for local dev. NEVER commit .env.

# --- Database ---
# Format: postgres://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgres://glosspilot:glosspilot@localhost:5432/glosspilot

# --- Auth ---
# 32+ char random string. Generate: openssl rand -hex 32
AUTH_SECRET=replace-me-with-openssl-rand-hex-32
# Cookie domain (omit for localhost)
AUTH_COOKIE_DOMAIN=

# --- API ---
API_PORT=3001
API_ORIGIN=http://localhost:3001
# CORS allowed origins, comma-separated
WEB_ORIGIN=http://localhost:5173

# --- Web ---
VITE_API_URL=http://localhost:3001

# --- File storage (v0.6+) ---
# S3-compatible. For local dev: MinIO. For prod: R2 / S3 / Backblaze.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Locale ---
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Europe/Berlin
